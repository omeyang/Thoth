# design-review cron-batch.sh 的项目旋钮（示例）。复制本目录为 <profile-root>/design-review/<name>/ 后按项目填写。
# 本文件会被 bash source，只写 KEY=VALUE。

# 必填：被审仓库根目录
REPO=/path/to/project
# 必填：设计文档子目录（相对 REPO）；cron 按 00-*.md → PARENT_DOC → 其余 01-*.md 的顺序逐篇审
REDESIGN_SUBDIR=design
# 可选：父级详设文件名，排在 00-* 之后、其余 01-* 之前
#PARENT_DOC=01-core.md
# 可选：每篇最多轮次（命令行 MAX_ROUNDS=… 优先）
MAX_ROUNDS=5
# 可选：<= 该小时算作前一晚的窗口（窗口跨午夜）
WINDOW_END_HOUR=7
